# Single authoritative ignore file for this monorepo. Add a local .gitignore only
# when a directory becomes an independently published/distributed package
# (npm package, Rust crate, Tauri plugin) and must stay self-contained.

# Local project tooling and machine-local configuration
/blehub.local.toml
*.local.toml
/.pixi/
/.codegraph/
/.zvec-grep/
/.ruff_cache/
/.logs/
.ropeproject/
.pyright/
.venv/
venv/
.eggs/
*.egg-info/
.tox/
.nox/
.cache/
.vagrant/

# JavaScript/TypeScript package caches and build output
**/node_modules/
**/.expo/
**/.metro-cache/
**/.metro-health-check*
**/.turbo/
**/.nx/
**/.pnpm-store/
**/.eslintcache
**/.stylelintcache
**/.nyc_output/
**/coverage/
*.tsbuildinfo
/examples/tauri-blehub-internal/ui/test-results/
/examples/tauri-blehub-internal/ui/playwright-report/
/examples/tauri-blehub-internal/ui/blob-report/
/examples/archive/tauri-blehub-internal/ui/test-results/
/examples/archive/tauri-blehub-internal/ui/playwright-report/
/examples/archive/tauri-blehub-internal/ui/blob-report/

# Python caches and test output
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Isolated work and collected CI output
**/.work/
/artifacts/

# Rust build output
**/target/
*.rs.bk
*.profraw
*.profdata
lcov.info

# Gradle, Kotlin, and Android build output
**/.gradle/
**/.kotlin/
**/.cxx/
**/.externalNativeBuild/
**/build/
**/out/
**/captures/
local.properties
*.apk
*.aab
*.aar
*.iml

# Apple and Swift build output
**/.build/
**/.swiftpm/
**/DerivedData/
**/Pods/
xcuserdata/
*.xcuserstate
*.xcresult
*.xcarchive
*.xcframework/
*.dSYM/
*.ipa
*.hmap
*.xctestrun
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xccheckout
*.xcscmblueprint
**/.xcode.env.local
/tests/hil/apple/ios/BleHubAppleIOSProbe.xcodeproj/
/tests/consumers/react-native-internal/ios/Pods/
/tests/consumers/react-native-internal/ios/*.xcworkspace/
/tests/consumers/react-native-internal/ios/.xcode.env.local
# Retired compile consumer: preserve ignored local output, not an active source root.
/tests/consumers/apple/bleng-rn-ios/
/tests/consumers/react-native-internal/macos/macos/Pods/
/tests/consumers/react-native-internal/macos/macos/*.xcworkspace/
/tests/consumers/react-native-internal/macos/macos/.xcode.env.local
/tests/consumers/archive/react-native-macos/macos/Pods/
/tests/consumers/archive/react-native-macos/macos/*.xcworkspace/
/tests/consumers/archive/react-native-macos/macos/.xcode.env.local

# Secrets and signing material (never commit)
.env
.env.local
.env.*.local
!.env.example
*.jks
*.keystore
!**/debug.keystore
*.bks
keystore.properties
signing.properties
google-services.json
GoogleService-Info.plist
*.p12
*.p8
*.pem
*.key
*.mobileprovision
id_rsa
id_ed25519

# Generated FFI bindings and package staging
# Reviewed API/ABI snapshots use a dedicated tracked directory when required.
**/generated/
**/nitrogen/
/integrations/react-native-bleng/site/
**/gen/
**/dist/
**/staging/
**/.tauri/
**/permissions/autogenerated/
/integrations/tauri-plugin-blehub/plugins/blehub/permissions/autogenerated/
/integrations/tauri-plugin-blehub/plugins/blehub/permissions/schemas/
/integrations/tauri-plugin-blehub/plugins/blehub/assembly/.tauri/
/integrations/archive/tauri-plugin-blehub/plugins/blehub/permissions/autogenerated/
/integrations/archive/tauri-plugin-blehub/plugins/blehub/permissions/schemas/
/integrations/archive/tauri-plugin-blehub/plugins/blehub/assembly/.tauri/
/integrations/react-native-internal/apple-production/
/integrations/react-native-internal/android/.cxx/
/tests/consumers/react-native-internal/android/app/.cxx/

# Native binary artifacts
*.dll
*.dylib
*.so
*.a
*.lib
*.pdb
*.o
*.obj

# Archives produced by packaging; build outputs must not be committed
*.zip
*.tgz
*.tar.gz

# VM images and firmware binaries built or provisioned outside the tree
*.qcow2
*.vmdk
*.vdi
*.iso
*.img
*.hex
*.uf2
*.elf
*.bin

