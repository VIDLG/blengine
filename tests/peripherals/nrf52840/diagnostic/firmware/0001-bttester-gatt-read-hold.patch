 		if (!attr->read) {
@@ -2798,4 +3081,26 @@ static const struct btp_handler handlers[] = {
 		.expect_len = sizeof(struct btp_gatt_remove_handle_from_db_cmd),
 		.func = remove_by_handle_from_db,
 	},
+#if defined(CONFIG_BTTESTER_GATT_READ_HOLD)
+	{
+		.opcode = BTP_GATT_READ_HOLD_ARM,
+		.expect_len = sizeof(struct btp_gatt_read_hold_arm_cmd),
+		.func = read_hold_arm,
+	},
+	{
+		.opcode = BTP_GATT_READ_HOLD_RELEASE,
+		.expect_len = sizeof(struct btp_gatt_read_hold_control_cmd),
+		.func = read_hold_release,
+	},
+	{
+		.opcode = BTP_GATT_READ_HOLD_ABORT,
+		.expect_len = sizeof(struct btp_gatt_read_hold_control_cmd),
+		.func = read_hold_abort,
+	},
+	{
+		.opcode = BTP_GATT_READ_HOLD_STATUS,
+		.expect_len = 0,
+		.func = read_hold_status,
+	},
+#endif
 };
