+config BTTESTER_GATT_READ_HOLD_TIMEOUT_MS
+	int "GATT read hold timeout in milliseconds"
+	depends on BTTESTER_GATT_READ_HOLD
+	default 5000
+	range 1 60000
+	help
+	  Maximum time that an armed authorization-protected GATT read may wait
+	  for the matching remote read and release or abort command. A timeout
+	  fails the read closed with ATT authorization error.
+
