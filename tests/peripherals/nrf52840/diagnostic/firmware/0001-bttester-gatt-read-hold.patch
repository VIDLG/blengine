+		    !read_hold_claim(attr->handle, &sequence) ||
+		    !read_hold_wait(sequence)) {
+			return BT_GATT_ERR(BT_ATT_ERR_AUTHORIZATION);
+		}
+#else
 		return BT_GATT_ERR(BT_ATT_ERR_AUTHORIZATION);
+#endif
 	}
@@ -2470,4 +2746,11 @@ static uint8_t get_attr_val_rp(const struct bt_gatt_attr *attr, uint16_t handle,
 	do {
 		to_read = net_buf_simple_tailroom(buf);
 
