{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@blehub/react-native-bleng": ["../../../integrations/react-native-bleng/src/index.ts"],
      "@blehub/react-native-bleng/*": ["../../../integrations/react-native-bleng/*"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react-native": ["./node_modules/react-native/types/index.d.ts"]
    },
    "jsx": "react-native",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["react", "jest"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
