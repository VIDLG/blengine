{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@blehub/react-native-internal": ["../../../integrations/react-native-internal/src/index.ts"],
      "react": ["../../../integrations/react-native-internal/node_modules/@types/react/index.d.ts"],
      "react-native": ["../../../integrations/react-native-internal/node_modules/react-native/types/index.d.ts"]
    },
    "jsx": "react-native",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["../../../integrations/react-native-internal/node_modules/@types"],
    "types": ["react"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
