# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16.0'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'BleHubNitroHost' do
  config = use_native_modules!

  # Keep the production Apple backend and staged UniFFI bindings as separate
  # Swift modules. The Nitro pod depends on both; this explicit local
  # declaration is only for the repository-owned internal host.
  pod 'BleHubUniFfi', :path => '../../../../integrations/react-native-internal/apple-pods/BleHubUniFfi'
  pod 'BleHubApple', :path => '../../../../integrations/react-native-internal/apple-pods/BleHubApple'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end

target 'BleHubNitroHostNativeTests' do
  inherit! :complete
  pod 'BleHubReactNative', :path => '../../../../integrations/react-native-internal'
  pod 'BleHubUniFfi', :path => '../../../../integrations/react-native-internal/apple-pods/BleHubUniFfi'
  pod 'BleHubApple', :path => '../../../../integrations/react-native-internal/apple-pods/BleHubApple'
end
