  "productName": "BleHub Tauri Internal",
  "version": "0.0.0",
  "identifier": "dev.blehub.tauri.blehubinternal",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
